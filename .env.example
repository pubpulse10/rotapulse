# Flask session signing key.
# In production this MUST be the identical value set on PricePulse's and
# TaskPulse's SECRET_KEY too — that's what lets one PubPulse login (and the
# RotaPulse-local staff session) be recognised across apps where relevant.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Production only — leave unset locally. Must be ".pubpulse.co.uk" (with
# the leading dot) and must match the sibling apps' SESSION_COOKIE_DOMAIN
# exactly.
SESSION_COOKIE_DOMAIN=

# Where an unauthenticated venue-owner visitor is sent to log into the
# shared PubPulse account. Defaults to the real production URL if unset.
PRICEPULSE_LOGIN_URL=https://pricepulse.pubpulse.co.uk/login

# Authenticates this app's push to the PubPulse Hub, AND TaskPulse's inbound
# call to /internal/clock-status. Must be identical across all family env
# vars. Generate the same way as SECRET_KEY.
INTERNAL_API_SECRET=
PUBPULSE_HUB_URL=https://pubpulse.co.uk

# Set to "production" once actually deployed (forces HTTPS-only session cookies).
FLASK_ENV=development

# Free trial length (days) for a newly-provisioned venue before a
# subscription is required.
ROTAPULSE_TRIAL_DAYS=30

# Stripe — same PubPulse Stripe account as the sibling apps, RotaPulse's own
# Product/Price and webhook endpoint. STRIPE_PRICE_STAFF_TIERED is the one
# tiered/volume Price ID (see scripts/create_stripe_price.py).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STAFF_TIERED=

# Same Brevo SMTP relay account as the sibling apps.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Twilio — new to the PubPulse family. Unset means SMS is logged, not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Who gets notified when a venue starts a trial or converts to a paid
# subscription.
SUBSCRIBER_NOTIFY_EMAIL=

# Clock-in/out geolocation verification radius, in metres (spec §6.1).
CLOCK_IN_RADIUS_METRES=30
